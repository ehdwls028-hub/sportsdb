{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/public/$1" },
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/favicon.png", "dest": "/public/favicon.png" },
    { "src": "/style.css", "dest": "/public/style.css" },
    { "src": "/logo.png", "dest": "/public/logo.png" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
