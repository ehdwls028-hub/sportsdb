<%- include('header') %>
<main>
  <div style="max-width: 600px; margin: 0 auto;">
    <a href="/admin" class="back-link">← Admin으로</a>
    <h2 style="font-size:1.3rem; font-weight:700; margin-bottom:1.2rem; color:var(--text-primary);">✏️ 기사 수정</h2>

    <form action="/admin/articles/<%= post.id %>/edit" method="POST" enctype="multipart/form-data" class="admin-article-form">
      <div class="form-group">
        <label>제목</label>
        <input type="text" name="title" class="form-input" value="<%= post.title %>" required>
      </div>

      <div class="form-group">
        <label>대표 이미지</label>
        <% if (post.thumbnail) { %>
        <div style="margin-bottom:0.5rem;">
          <img src="<%= post.thumbnail %>" style="max-height:150px; border-radius:6px;">
        </div>
        <% } %>
        <input type="file" name="image" accept="image/*" class="form-input">
        <p style="font-size:0.72rem; color:var(--text-muted); margin-top:0.2rem;">새 이미지를 선택하지 않으면 기존 이미지가 유지됩니다.</p>
      </div>

      <div class="form-group">
        <label>내용</label>
        <textarea name="content" class="form-textarea" rows="10"><%= post.content || '' %></textarea>
      </div>

      <div style="display:flex; gap:0.5rem;">
        <button type="submit" class="form-btn">💾 저장</button>
        <a href="/admin" class="form-btn" style="background:var(--text-muted); text-decoration:none;">취소</a>
      </div>
    </form>
  </div>
</main>
<%- include('footer') %>
